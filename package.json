{
    "name": "tee-skin-renderer",
    "version": "0.1.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tee-community/tee-skin-renderer.git"
    },
    "main": "./dist/tee-skin-renderer.umd.js",
    "module": "./dist/tee-skin-renderer.esm.js",
    "types": "./dist/tee-skin-renderer.d.ts",
    "exports": {
        ".": {
            "import": "./dist/tee-skin-renderer.esm.js",
            "require": "./dist/tee-skin-renderer.umd.js",
            "types": "./dist/tee-skin-renderer.d.ts"
        },
        "./css": {
            "import": "./dist/tee-skin-renderer.css",
            "require": "./dist/tee-skin-renderer.css"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "typescript": "^6.0.2",
        "vite": "^8.0.8",
        "vite-plugin-dts": "^4.5.4"
    }
}
